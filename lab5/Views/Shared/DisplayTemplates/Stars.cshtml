@model int

@{
    var rating = Model;
    if (rating < 0)
    {
        rating = 0;
    }
    if (rating > 5)
    {
        rating = 5;
    }
}

<span title="@rating">
@for (int i = 0; i < 5; i++)
{
    if (i < rating)
    {
        @Html.Raw("&#x2605;")
    }
    else
    {
        @Html.Raw("&#x2606;")
    }
}
</span>
